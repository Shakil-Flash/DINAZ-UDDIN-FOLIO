# ==============================================================================
# Dinaz Uddin Portfolio — Production & Development Environment Configuration
# ==============================================================================
#
# SECURITY RULES:
# 1. NEVER commit real credentials, tokens, or API keys to git or version control.
# 2. Copy this template to .env.local for local development:
#      cp .env.example .env.local
# 3. For production on Vercel: add these keys in Project Settings > Environment Variables.
# 4. Only variables prefixed with NEXT_PUBLIC_ are exposed to the client bundle.
#    All other variables remain strictly server-side.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Metadata & Canonical URL
# ------------------------------------------------------------------------------
# In local development: http://localhost:3000
# In production: https://dinazuddin.dev (used for sitemap.xml, robots.txt, metadata)
NEXT_PUBLIC_SITE_URL=https://dinazuddin.dev

# ------------------------------------------------------------------------------
# 2. Contact Message Delivery (Resend API) [Server-Side Only]
# ------------------------------------------------------------------------------
# If unconfigured: The contact form operates in safe demonstration mode (HTTP 503)
# and never falsely claims a message was delivered.
# To activate real email transmission, obtain a key from https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Recipient destination for portfolio inquiries
CONTACT_EMAIL_TO=contact@dinazuddin.dev

# Sender address. Default uses Resend onboarding domain until custom domain is verified.
# Once dinazuddin.dev domain is verified in Resend dashboard, change to:
# CONTACT_EMAIL_FROM=Dinaz Uddin <contact@dinazuddin.dev>
CONTACT_EMAIL_FROM=Dinaz Portfolio <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 3. AI Assistant Provider (Vercel AI SDK) [Server-Side Only]
# ------------------------------------------------------------------------------
# If unconfigured: The assistant UI displays a clean notice that the service is offline.
# Compatible with OpenAI, Groq, OpenRouter, or any OpenAI-compatible provider.
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini
# Optional base URL if using compatible proxies or self-hosted models
# AI_BASE_URL=https://api.openai.com/v1

# ------------------------------------------------------------------------------
# 4. Distributed Rate Limiting (Upstash Redis REST) [Server-Side Only]
# ------------------------------------------------------------------------------
# Recommended for horizontally scaled production / serverless environments.
# If unconfigured: The application falls back safely to single-instance in-memory limiter.
# Create a free serverless Redis database at https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here
