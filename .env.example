# ==============================================================================
# Dinaz Uddin Portfolio - Environment Configuration
# ==============================================================================
#
# IMPORTANT:
# - Never commit real credentials to version control.
# - Copy this file to .env.local for local development.
# - All keys configured here are strictly server-side and never exposed to the client.
#
# AI Provider Configuration (Vercel AI SDK):
# Supported server environment variables:
AI_API_KEY=your_ai_api_key_here
AI_MODEL=gpt-4o-mini
# Optional base URL if using compatible proxies or self-hosted models
# AI_BASE_URL=https://api.openai.com/v1

# Site URL for metadata & canonical URLs
NEXT_PUBLIC_SITE_URL=http://localhost:3000
